// D3, is on-robot triage choosing well? A falling yield means the fleet is
// uploading things the cloud then discards: retune the twin thresholds before
// anyone proposes buying more uplink.
declare query_parameters(window:timespan = 28d);
FleetHealth_CL
| where TimeGenerated > ago(window)
| summarize good = sum(retained_frames_d), valid = sum(uploaded_frames_d)
