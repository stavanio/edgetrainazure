// C4; the longest pole in the 11-day loop. 90% is deliberately loose:
// tightening it buys loop time only if annotator capacity moves with it.
declare query_parameters(window:timespan = 28d, budget:timespan = 72h);
LabelQueue_CL
| where TimeGenerated > ago(window) and route_s startswith "human"
| extend wait = adjudicated_t - routed_t
| summarize good = countif(isnotnull(adjudicated_t) and wait <= budget), valid = count()
